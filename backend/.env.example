# Database Configuration
# Option 1 – supply a full connection URL (takes priority when set)
# DATABASE_URL=postgresql://user:password@host:5432/booker_db

# Option 2 – individual connection parameters (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=booker_db

# Set DB_SSL=true when your database server requires SSL/TLS (e.g. Railway,
# Render, Supabase, Heroku, or any other managed cloud database).
# Leave unset or set to false for local PostgreSQL without SSL.
# DB_SSL=true

# By default, certificate validation is enabled (rejectUnauthorized=true).
# Only set DB_SSL_REJECT_UNAUTHORIZED=false if your provider uses self-signed
# certificates AND you accept the security trade-off of skipping cert validation.
# DB_SSL_REJECT_UNAUTHORIZED=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Application
NODE_ENV=development
PORT=3000

# CORS
CORS_ORIGIN=http://localhost:8081,http://localhost:19007

# Paystack Billing
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxx
PAYSTACK_CALLBACK_URL=http://localhost:3000/billing/callback

# Mailgun Email (OTP + notifications)
MAILGUN_ENABLED=true
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your-mailgun-domain.com
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM_EMAIL=no-reply@yourdomain.com
MAILGUN_FROM_NAME=BizRecord

# In-process email queue
EMAIL_QUEUE_POLL_INTERVAL_MS=1000
EMAIL_QUEUE_MAX_ATTEMPTS=5

# API Documentation
SWAGGER_ENABLED=true

# Cloudflare R2 configuration for receipts
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://your_public_url.r2.dev

# RevenueCat Webhook (subscription management)
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
REVENUECAT_WEBHOOK_AUTH_DISABLED=true
